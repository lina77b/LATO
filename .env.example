# Copier ce fichier en .env puis adapter les valeurs
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
# True en développement uniquement
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# True en production derrière HTTPS (cookies sécurisés, HSTS, redirection SSL)
USE_HTTPS=False
# Origines autorisées pour l'API (séparées par des virgules), vide = aucune
CORS_ALLOWED_ORIGINS=
# Compte Super Admin créé par `python manage.py seed_db`
# (si ADMIN_PASSWORD est vide, un mot de passe aléatoire est généré et affiché)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
